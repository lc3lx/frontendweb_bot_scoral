# Production build env for Vite (baked into the JS bundle at build time).
# Copy on VPS:
#   cp .env.production.example .env.production
#
# Deploy URL: https://web.scaralphaai.com (nginx → PM2 scaralpha-webapp :4175)
#
# Same-origin API (nginx on web.scaralphaai.com proxies /api → backend): leave empty.
# Cross-origin API: set to https://www.scaralphaai.com
VITE_API_BASE_URL=
